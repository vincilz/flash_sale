{
  "Name": "reduceStorageAndAccount",
  "Comment": "扣减库存和账户金额",
  "StartState": "ReduceStorage",
  "TenantId": "000001",
  "Version": "1.0.0",
  "States": {
    "ReduceStorage": {
      "Type": "ServiceTask",
      "ServiceName": "storageApiService",
      "ServiceMethod": "reduce",
      "CompensateState": "CompensateReduceStorage",
      "Next": "ChoiceState",
      "Input": [
        "$.[storageRequest]"
      ],
      "Output": {
        "reduceStorageResult": "$.#root"
      },
      "Status": {
        "#root == true": "SU",
        "#root == false": "FA",
        "$Exception{java.lang.Throwable}": "UN"
      }
    },
    "ChoiceState": {
      "Type": "Choice",
      "Choices": [
        {
          "Expression": "[reduceStorageResult] == true",
          "Next": "ReduceAccount"
        }
      ],
      "Default": "Fail"
    },
    "ReduceAccount": {
      "Type": "ServiceTask",
      "ServiceName": "accountApiService",
      "ServiceMethod": "reduce",
      "CompensateState": "CompensateReduceAccount",
      "Input": [
        "$.[accountRequest]"
      ],
      "Output": {
        "reduceAccountResult": "$.#root"
      },
      "Status": {
        "#root == true": "SU",
        "#root == false": "FA",
        "$Exception{java.lang.Throwable}": "UN"
      },
      "Catch": [
        {
          "Exceptions": [
            "java.lang.Throwable"
          ],
          "Next": "CompensationTrigger"
        }
      ],
      "Next": "Succeed"
    },
    "CompensateReduceStorage": {
      "Type": "ServiceTask",
      "ServiceName": "storageApiService",
      "ServiceMethod": "compensateReduce",
      "Input": [
        "$.[businessKey]"
      ]
    },
    "CompensateReduceAccount": {
      "Type": "ServiceTask",
      "ServiceName": "accountApiService",
      "ServiceMethod": "compensateReduce",
      "Input": [
        "$.[businessKey]"
      ]
    },
    "CompensationTrigger": {
      "Type": "CompensationTrigger",
      "Next": "Fail"
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "Fail": {
      "Type": "Fail",
      "ErrorCode": "PURCHASE_FAILED",
      "Message": "purchase failed"
    }
  }
}